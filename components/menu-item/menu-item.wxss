/* components/menu-item/menu-item.wxss — 商品卡片样式 */
.mi-card {
  display: flex;
  padding: 20rpx;
  background: var(--bg-surface);
  margin-bottom: var(--space-sm);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
  animation: cardEntry 0.35s ease both;
}

@keyframes cardEntry {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.mi-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-sm);
}

.mi-card__image {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  background: var(--border-light);
}

.mi-card__info {
  flex: 1;
  margin-left: var(--space-md);
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.mi-card__name {
  font-size: var(--text-subhead);
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.3;
}

.mi-card__desc {
  font-size: var(--text-caption);
  color: var(--text-tertiary);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  line-height: 1.4;
}

/* 标签 */
.mi-card__tags {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
  flex-wrap: wrap;
}

.mi-card__tag {
  font-size: 20rpx;
  color: var(--color-primary);
  background: var(--color-primary-bg);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  line-height: 1.3;
}

/* 底部区域 */
.mi-card__bottom {
  display: flex;
  align-items: center;
  margin-top: auto;
  padding-top: 10rpx;
}

.mi-card__price {
  color: var(--color-primary);
  font-size: var(--text-heading);
  font-weight: 700;
  flex: 1;
}

.mi-card__ctrl {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

/* 减号按钮 */
.mi-card__minus {
  width: 0;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  overflow: hidden;
  transition: all 0.2s ease;
}

.mi-card__minus--show {
  width: 44rpx;
  opacity: 1;
}

.mi-card__minus:active {
  background: var(--color-primary-bg);
  transform: scale(0.9);
}

.mi-card__minus-icon {
  color: var(--color-primary);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
}

/* 数量 */
.mi-card__qty {
  font-size: var(--text-body);
  color: var(--text-primary);
  min-width: 30rpx;
  text-align: center;
  font-weight: 500;
  opacity: 0;
  transform: scale(0.5);
  transition: all 0.2s ease;
}

.mi-card__qty--show {
  opacity: 1;
  transform: scale(1);
}

/* 加号按钮 */
.mi-card__add {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary) 0%, #F48C7A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(242, 107, 94, 0.25);
  transition: all 0.15s ease;
  position: relative;
  overflow: hidden;
}

/* 加购扩散波纹 */
.mi-card__add::after {
  content: '';
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0);
  opacity: 0;
}

.mi-card__add:active::after {
  animation: addRipple 0.35s ease;
}

@keyframes addRipple {
  0% { transform: scale(0); opacity: 0.6; }
  100% { transform: scale(2.5); opacity: 0; }
}

.mi-card__add:active {
  transform: scale(0.8);
  box-shadow: 0 2rpx 6rpx rgba(242, 107, 94, 0.15);
}

.mi-card__add-icon {
  color: var(--text-white);
  font-size: 34rpx;
  font-weight: 300;
  line-height: 1;
}
