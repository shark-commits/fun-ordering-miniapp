/* ═══════════════════════════════════════════
   components/cart-bar/cart-bar.wxss — 购物车栏样式（优化版）
   设计：温暖治愈 × 活力玩趣
   ═══════════════════════════════════════════ */

/* ====== 底部固定栏 ====== */
.cb {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 110rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: linear-gradient(135deg, #3D2C25 0%, #5A4038 100%);
  display: flex;
  align-items: center;
  padding: 0 var(--space-lg);
  z-index: 100;
  box-shadow: 0 -4rpx 20rpx rgba(61, 44, 37, 0.15);
}

/* ====== 购物车图标 ====== */
.cb__icon-wrap {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cb__icon-bg {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, var(--color-primary) 0%, #F48C7A 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(242, 107, 94, 0.3);
  transition: transform 0.2s ease;
}

/* 弹跳动画 — 加购时触发 */
.cb__icon-bg--bounce {
  animation: iconBounce 0.4s ease;
}

@keyframes iconBounce {
  0% { transform: scale(1); }
  30% { transform: scale(1.2); }
  60% { transform: scale(0.9); }
  100% { transform: scale(1); }
}

.cb__icon-emoji {
  font-size: 36rpx;
  line-height: 1;
}

/* 角标 */
.cb__badge {
  position: absolute;
  top: -6rpx;
  right: -4rpx;
  background: var(--color-playful-yellow);
  min-width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 17rpx;
  padding: 0 6rpx;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
}

.cb__badge--pop {
  animation: badgePop 0.3s ease;
}

@keyframes badgePop {
  0% { transform: scale(1); }
  50% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

.cb__badge-text {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-primary);
}

/* ====== 价格区域 ====== */
.cb__price-wrap {
  flex: 1;
  margin-left: var(--space-md);
  min-width: 0;
}

.cb__price {
  color: var(--text-white);
  font-size: 38rpx;
  font-weight: 700;
  display: block;
}

/* 空状态提示 */
.cb__tip-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.cb__tip-icon {
  font-size: 24rpx;
  line-height: 1;
}

.cb__tip {
  color: var(--text-tertiary);
  font-size: var(--text-body-sm);
}

/* 件数 */
.cb__count {
  color: rgba(255, 255, 255, 0.5);
  font-size: var(--text-caption);
  display: block;
  margin-top: 2rpx;
}

/* ====== 结算按钮 ====== */
.cb__btn {
  background: linear-gradient(135deg, var(--color-primary) 0%, #F48C7A 100%);
  color: var(--text-white);
  font-size: var(--text-subhead);
  font-weight: 600;
  padding: 0 44rpx;
  height: 76rpx;
  line-height: 76rpx;
  border-radius: var(--radius-full);
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(242, 107, 94, 0.3);
  transition: all 0.15s ease;
  flex-shrink: 0;
}

.cb__btn:active {
  transform: scale(0.94);
  box-shadow: 0 2rpx 8rpx rgba(242, 107, 94, 0.15);
}

.cb__btn--disabled {
  background: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.35);
  box-shadow: none;
}

.cb__btn--disabled:active {
  transform: none;
}

.cb__btn-text {
  display: block;
}

/* ====== 遮罩 ====== */
.cb__mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(61, 44, 37, 0.4);
  z-index: 99;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.cb__mask--show {
  opacity: 1;
  pointer-events: auto;
}

/* ====== 购物车弹层 ====== */
.cb__popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--bg-surface);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  z-index: 101;
  box-shadow: 0 -8rpx 32rpx rgba(61, 44, 37, 0.1);
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.cb__popup--show {
  transform: translateY(0);
}

/* 拖拽条 */
.cb__popup-handle {
  width: 48rpx;
  height: 4rpx;
  background: var(--border-medium);
  border-radius: 2rpx;
  margin: var(--space-sm) auto 0;
  flex-shrink: 0;
}

/* 头部 */
.cb__popup-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--space-lg);
  border-bottom: 1rpx solid var(--border-light);
  flex-shrink: 0;
}

.cb__popup-header-left {
  flex: 1;
}

.cb__popup-title {
  font-size: var(--text-subhead);
  font-weight: 600;
  color: var(--text-primary);
  display: block;
}

.cb__popup-total {
  font-size: var(--text-caption);
  color: var(--text-tertiary);
  display: block;
  margin-top: 4rpx;
}

.cb__popup-clear {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: var(--text-body-sm);
  color: var(--text-tertiary);
  padding: 8rpx 16rpx;
  border-radius: var(--radius-full);
  transition: all 0.15s ease;
  flex-shrink: 0;
}

.cb__popup-clear:active {
  background: var(--border-light);
  transform: scale(0.95);
}

.cb__popup-clear-icon {
  font-size: 22rpx;
  line-height: 1;
}

/* 商品列表 */
.cb__popup-list {
  flex: 1;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.cb__popup-item {
  display: flex;
  align-items: center;
  padding: var(--space-md) var(--space-lg);
  border-bottom: 1rpx solid #FAF3EF;
  animation: popupItemIn 0.3s ease both;
}

@keyframes popupItemIn {
  from {
    opacity: 0;
    transform: translateX(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.cb__popup-item:last-child {
  border-bottom: none;
}

.cb__popup-info {
  flex: 1;
  min-width: 0;
}

.cb__popup-name {
  font-size: var(--text-body);
  color: var(--text-primary);
  display: block;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cb__popup-spec {
  font-size: var(--text-caption);
  color: var(--text-tertiary);
  display: block;
  margin-top: 2rpx;
}

.cb__popup-price {
  color: var(--color-primary);
  font-size: var(--text-body);
  font-weight: 600;
  margin-right: var(--space-md);
  flex-shrink: 0;
  min-width: 80rpx;
  text-align: right;
}

/* 弹层内的数量控制按钮 */
.cb__popup-ctrl {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.cb__popup-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
}

.cb__popup-btn:active {
  transform: scale(0.85);
}

.cb__popup-btn--minus {
  border: 2rpx solid var(--border-medium);
}

.cb__popup-btn--minus:active {
  background: var(--border-light);
}

.cb__popup-btn--plus {
  background: linear-gradient(135deg, var(--color-primary) 0%, #F48C7A 100%);
  box-shadow: 0 2rpx 8rpx rgba(242, 107, 94, 0.2);
}

.cb__popup-btn-icon {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
  color: var(--text-secondary);
}

.cb__popup-btn--plus .cb__popup-btn-icon {
  color: var(--text-white);
}

.cb__popup-qty {
  font-size: var(--text-body);
  color: var(--text-primary);
  min-width: 30rpx;
  text-align: center;
  font-weight: 600;
}
