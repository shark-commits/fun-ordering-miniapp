/* components/sku-picker/sku-picker.wxss — 规格选择器样式 */
.sku-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(61, 44, 37, 0.45);
  z-index: 200;
  animation: fadeIn 0.2s ease;
}

.sku-picker {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--bg-surface);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  z-index: 201;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -8rpx 32rpx rgba(61, 44, 37, 0.12);
}

.sku-picker--show {
  transform: translateY(0);
}

/* 拖拽条 */
.sku-picker__handle {
  width: 48rpx;
  height: 4rpx;
  background: var(--border-medium);
  border-radius: 2rpx;
  margin: var(--space-sm) auto var(--space-xs);
}

/* 头部 */
.sku-picker__header {
  display: flex;
  padding: var(--space-lg);
  border-bottom: 1rpx solid var(--border-light);
  position: relative;
}

.sku-picker__image {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
  background: var(--border-light);
  box-shadow: var(--shadow-sm);
}

.sku-picker__header-info {
  flex: 1;
  margin-left: var(--space-md);
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.sku-picker__name {
  font-size: var(--text-subhead);
  font-weight: 600;
  color: var(--text-primary);
}

.sku-picker__price {
  font-size: var(--text-display);
  color: var(--color-primary);
  font-weight: 700;
  margin-top: var(--space-xs);
  display: block;
}

.sku-picker__close {
  position: absolute;
  top: var(--space-md);
  right: var(--space-md);
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-tertiary);
  border-radius: 50%;
  transition: all 0.15s ease;
}

.sku-picker__close:active {
  background: var(--border-light);
}

/* 内容区 */
.sku-picker__body {
  flex: 1;
  padding: var(--space-lg);
}

.sku-picker__group {
  margin-bottom: var(--space-xl);
}

.sku-picker__group-name {
  font-size: var(--text-body);
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--space-md);
  display: block;
}

/* 选项 */
.sku-picker__options {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-md);
}

.sku-picker__option {
  padding: 14rpx 32rpx;
  border-radius: var(--radius-full);
  background: #F5F0ED;
  font-size: var(--text-body);
  color: var(--text-primary);
  transition: all 0.15s ease;
}

.sku-picker__option:active {
  transform: scale(0.95);
}

.sku-picker__option--active {
  background: var(--color-primary-bg);
  color: var(--color-primary-dark);
  border: 2rpx solid var(--color-primary);
  font-weight: 600;
}

/* 数量选择 */
.sku-picker__qty {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sku-picker__qty-ctrl {
  display: flex;
  align-items: center;
  gap: var(--space-lg);
}

.sku-picker__qty-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border-medium);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--text-secondary);
  transition: all 0.15s ease;
}

.sku-picker__qty-btn:active {
  background: var(--border-light);
  transform: scale(0.92);
}

.sku-picker__qty-btn--primary {
  background: linear-gradient(135deg, var(--color-primary) 0%, #F48C7A 100%);
  border: none;
  color: var(--text-white);
  box-shadow: 0 2rpx 8rpx rgba(242, 107, 94, 0.2);
}

.sku-picker__qty-num {
  font-size: var(--text-heading);
  font-weight: 700;
  color: var(--text-primary);
  min-width: 40rpx;
  text-align: center;
}

/* 底部 */
.sku-picker__footer {
  padding: var(--space-md) var(--space-lg);
  padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom));
}

.sku-picker__confirm {
  background: linear-gradient(135deg, var(--color-primary) 0%, #F48C7A 100%);
  color: var(--text-white);
  text-align: center;
  padding: 24rpx 0;
  border-radius: var(--radius-full);
  font-size: var(--text-subhead);
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(242, 107, 94, 0.3);
  transition: all 0.15s ease;
}

.sku-picker__confirm:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 8rpx rgba(242, 107, 94, 0.15);
}
