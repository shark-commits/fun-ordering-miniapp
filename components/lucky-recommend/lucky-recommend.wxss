/* components/lucky-recommend/lucky-recommend.wxss — 幸运推荐样式 */
.lucky {
  margin: var(--space-md) var(--space-lg);
  background: linear-gradient(135deg, #FEF1ED 0%, #FDE8D8 50%, #FEF6F3 100%);
  border-radius: var(--radius-xl);
  padding: var(--space-lg);
  box-shadow: var(--shadow-md);
  position: relative;
  overflow: hidden;
}

/* ====== 装饰背景圆 ====== */
.lucky::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(242, 107, 94, 0.08) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.lucky::after {
  content: '';
  position: absolute;
  bottom: -30rpx;
  left: -30rpx;
  width: 120rpx;
  height: 120rpx;
  background: radial-gradient(circle, rgba(91, 192, 190, 0.08) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

/* ====== 头部 ====== */
.lucky__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-md);
  position: relative;
  z-index: 1;
}

.lucky__title-wrap {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

.lucky__title-icon {
  font-size: 32rpx;
  line-height: 1;
}

.lucky__title {
  font-size: var(--text-subhead);
  font-weight: 700;
  color: var(--color-primary-dark);
}

.lucky__shuffle {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-full);
  background: rgba(255, 255, 255, 0.6);
  transition: all 0.15s ease;
}

.lucky__shuffle:active {
  background: rgba(255, 255, 255, 0.9);
  transform: scale(0.95);
}

.lucky__shuffle-icon {
  font-size: 22rpx;
  line-height: 1;
}

.lucky__shuffle-text {
  font-size: var(--text-caption);
  color: var(--text-secondary);
}

/* ====== 推荐卡片 ====== */
.lucky__card {
  display: flex;
  position: relative;
  z-index: 1;
  transition: transform 0.3s ease;
}

.lucky__card--spin {
  animation: luckyShuffle 0.45s ease;
}

.lucky__card-bg {
  display: none;
}

.lucky__image {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-md);
  flex-shrink: 0;
  background: var(--border-light);
  box-shadow: 0 4rpx 12rpx rgba(242, 107, 94, 0.1);
}

.lucky__info {
  flex: 1;
  margin-left: var(--space-md);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.lucky__tag {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-white);
  background: linear-gradient(135deg, var(--color-playful-teal) 0%, #7DD4D2 100%);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-full);
  align-self: flex-start;
  margin-bottom: 6rpx;
  letter-spacing: 1rpx;
}

.lucky__name {
  font-size: var(--text-subhead);
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.3;
}

.lucky__desc {
  font-size: var(--text-caption);
  color: var(--text-tertiary);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lucky__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--space-sm);
}

.lucky__price {
  color: var(--color-primary);
  font-size: var(--text-heading);
  font-weight: 700;
}

.lucky__add-btn {
  background: linear-gradient(135deg, var(--color-primary) 0%, #F48C7A 100%);
  padding: 10rpx 28rpx;
  border-radius: var(--radius-full);
  box-shadow: 0 4rpx 12rpx rgba(242, 107, 94, 0.25);
  transition: all 0.15s ease;
}

.lucky__add-btn:active {
  transform: scale(0.92);
  box-shadow: 0 2rpx 6rpx rgba(242, 107, 94, 0.15);
}

.lucky__add-text {
  color: var(--text-white);
  font-size: var(--text-body-sm);
  font-weight: 600;
}

/* ====== 换一换动画 ====== */
@keyframes luckyShuffle {
  0% { transform: translateX(0) rotate(0deg); opacity: 1; }
  25% { transform: translateX(-20rpx) rotate(-3deg); opacity: 0.5; }
  50% { transform: translateX(20rpx) rotate(3deg); opacity: 0.5; }
  75% { transform: translateX(-10rpx) rotate(-1deg); opacity: 0.8; }
  100% { transform: translateX(0) rotate(0deg); opacity: 1; }
}
