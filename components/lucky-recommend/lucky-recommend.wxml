<!-- components/lucky-recommend/lucky-recommend.wxml — 今日幸运推荐 -->
<view class="lucky" bindtap="onShuffle">
  <!-- 头部 -->
  <view class="lucky__header">
    <view class="lucky__title-wrap">
      <text class="lucky__title-icon">🎲</text>
      <text class="lucky__title">今日幸运推荐</text>
    </view>
    <view class="lucky__shuffle">
      <text class="lucky__shuffle-icon">🔄</text>
      <text class="lucky__shuffle-text">换一个</text>
    </view>
  </view>

  <!-- 推荐卡片 -->
  <view class="lucky__card {{animating ? 'lucky__card--spin' : ''}}">
    <view class="lucky__card-bg"></view>
    <image class="lucky__image" src="{{current.image}}" mode="aspectFill" binderror="onImageError" />
    <view class="lucky__info">
      <view class="lucky__tag">💡 推荐</view>
      <text class="lucky__name">{{current.name}}</text>
      <text class="lucky__desc" wx:if="{{current.description}}">{{current.description}}</text>
      <view class="lucky__bottom">
        <text class="lucky__price">¥{{current.price}}</text>
        <view class="lucky__add-btn" catchtap="onAdd">
          <text class="lucky__add-text">+ 加入</text>
        </view>
      </view>
    </view>
  </view>
</view>
