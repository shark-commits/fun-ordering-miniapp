/* ═══════════════════════════════════════════
   pages/orders/orders.wxss — 预约记录页样式
   设计：温暖治愈 × 活力玩趣
   ═══════════════════════════════════════════ */

.orders-page {
  min-height: 100vh;
  background: var(--bg-page);
  box-sizing: border-box;
  animation: fadeIn 0.3s ease;
}

/* ====== 页面头部 ====== */
.orders-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  background: var(--bg-surface);
  border-bottom: 1rpx solid var(--border-light);
  position: sticky;
  top: 0;
  z-index: 10;
}

.orders-header__back {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--text-primary);
  border-radius: 50%;
  transition: all 0.15s ease;
}

.orders-header__back:active {
  background: var(--border-light);
  transform: scale(0.92);
}

.orders-header__title {
  font-size: var(--text-heading);
  font-weight: 700;
  color: var(--text-primary);
}

.orders-header__spacer {
  width: 56rpx;
}

/* ====== 空状态 ====== */
.orders-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
  animation: floatUp 0.5s ease;
}

.orders-empty__icon-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--color-primary-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-xl);
}

.orders-empty__icon {
  font-size: 72rpx;
  line-height: 1;
}

.orders-empty__title {
  font-size: var(--text-heading);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: var(--space-sm);
}

.orders-empty__sub {
  font-size: var(--text-body);
  color: var(--text-tertiary);
  margin-bottom: var(--space-2xl);
}

.orders-empty__btn {
  padding: 22rpx 72rpx;
  background: linear-gradient(135deg, var(--color-primary) 0%, #F48C7A 100%);
  color: var(--text-white);
  border-radius: var(--radius-full);
  font-size: var(--text-subhead);
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(242, 107, 94, 0.3);
  transition: all 0.15s ease;
}

.orders-empty__btn:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(242, 107, 94, 0.15);
}

/* ====== 订单列表 ====== */
.orders-list {
  padding: var(--space-md) var(--space-lg);
  padding-bottom: var(--space-2xl);
}

/* ====== 订单卡片 ====== */
.orders-card {
  background: var(--bg-surface);
  border-radius: var(--radius-xl);
  padding: var(--space-lg);
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-md);
  transition: all 0.2s ease;
  animation: cardSlideIn 0.4s ease both;
}

.orders-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-sm);
}

@keyframes cardSlideIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 卡片头部 */
.orders-card__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-md);
}

.orders-card__no-wrap {
  display: flex;
  align-items: center;
  gap: var(--space-xs);
}

.orders-card__no-label {
  font-size: var(--text-caption);
  color: var(--text-tertiary);
}

.orders-card__no {
  font-size: var(--text-caption);
  color: var(--text-tertiary);
  font-family: monospace;
  letter-spacing: 1rpx;
}

.orders-card__status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--text-caption);
  font-weight: 600;
  color: var(--color-success);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
  background: #F0F9F2;
}

.orders-card__status-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--color-success);
}

/* 商品列表 */
.orders-card__items {
  border-top: 1rpx solid var(--border-light);
  border-bottom: 1rpx solid var(--border-light);
  padding: var(--space-sm) 0;
  margin-bottom: var(--space-sm);
}

.orders-card__item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.orders-card__item-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.orders-card__item-dot {
  font-size: var(--text-body);
  color: var(--color-primary);
  font-weight: 700;
  flex-shrink: 0;
}

.orders-card__item-name {
  font-size: var(--text-body);
  color: var(--text-primary);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.orders-card__item-price {
  font-size: var(--text-body-sm);
  color: var(--text-tertiary);
  margin-left: var(--space-md);
  flex-shrink: 0;
}

/* 底部 */
.orders-card__footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.orders-card__time-wrap {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.orders-card__time-icon {
  font-size: 20rpx;
  line-height: 1;
}

.orders-card__time {
  font-size: var(--text-caption);
  color: var(--text-tertiary);
}

.orders-card__total {
  font-size: var(--text-body);
  color: var(--text-primary);
}

.orders-card__total-price {
  font-size: var(--text-body-bold);
  color: var(--color-primary);
  font-weight: 700;
}

/* ====== 列表到底提示 ====== */
.orders-footer {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding: 48rpx 0 32rpx;
}

.orders-footer__line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(to right, transparent, var(--border-light), transparent);
}

.orders-footer__text {
  font-size: var(--text-caption);
  color: var(--text-tertiary);
  flex-shrink: 0;
}
