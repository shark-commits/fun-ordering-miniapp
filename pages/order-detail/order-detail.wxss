/* ═══════════════════════════════════════════
   pages/order-detail/order-detail.wxss — 订单详情页样式
   ═══════════════════════════════════════════ */

.detail-page {
  padding: var(--space-lg);
  padding-bottom: 160rpx;
  background: var(--bg-page);
  min-height: 100vh;
  animation: fadeIn 0.3s ease;
}

/* ====== 成功状态 ====== */
.detail-success {
  text-align: center;
  padding: 48rpx 0 32rpx;
  animation: floatUp 0.5s ease;
}

.detail-success__icon-wrap {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto var(--space-lg);
  background: linear-gradient(135deg, var(--color-success) 0%, #8DD49A 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: popIn 0.4s ease 0.15s both;
  box-shadow: 0 8rpx 32rpx rgba(107, 196, 122, 0.3);
}

.detail-success__icon {
  color: var(--text-white);
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1;
}

.detail-success__text {
  font-size: var(--text-display);
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: var(--space-xs);
}

.detail-success__sub {
  font-size: var(--text-body);
  color: var(--text-tertiary);
  display: block;
}

/* ====== 信息卡片 ====== */
.detail-card {
  background: var(--bg-surface);
  border-radius: var(--radius-xl);
  padding: var(--space-lg);
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-md);
  animation: floatUp 0.4s ease 0.1s both;
}

.detail-card__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: var(--space-md);
  border-bottom: 1rpx solid var(--border-light);
  margin-bottom: var(--space-md);
}

.detail-card__order-no {
  font-size: var(--text-caption);
  color: var(--text-tertiary);
  font-family: monospace;
}

.detail-card__status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--text-body-sm);
  color: var(--color-primary);
  font-weight: 600;
}

.detail-card__status--done {
  color: var(--color-success);
}

.detail-card__status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-primary);
}

.detail-card__status--done .detail-card__status-dot {
  background: var(--color-success);
}

/* ====== 商品项 ====== */
.detail-item {
  display: flex;
  align-items: center;
  padding: var(--space-sm) 0;
}

.detail-item__image {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  background: var(--border-light);
}

.detail-item__info {
  flex: 1;
  margin-left: var(--space-md);
  min-width: 0;
}

.detail-item__name {
  font-size: var(--text-body);
  color: var(--text-primary);
  display: block;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-item__spec {
  font-size: var(--text-caption);
  color: var(--text-tertiary);
  display: block;
  margin-top: 4rpx;
}

.detail-item__right {
  text-align: right;
  flex-shrink: 0;
}

.detail-item__price {
  font-size: var(--text-body);
  color: var(--color-primary);
  font-weight: 600;
  display: block;
}

.detail-item__qty {
  font-size: var(--text-caption);
  color: var(--text-tertiary);
  display: block;
  margin-top: 4rpx;
}

/* ====== 备注 ====== */
.detail-remark {
  display: flex;
  align-items: flex-start;
  gap: var(--space-sm);
  padding: var(--space-sm) 0;
  margin-top: var(--space-sm);
  border-top: 1rpx solid var(--border-light);
}

.detail-remark__label {
  font-size: var(--text-caption);
  color: var(--text-tertiary);
  flex-shrink: 0;
}

.detail-remark__text {
  font-size: var(--text-caption);
  color: var(--text-secondary);
  flex: 1;
}

/* ====== 分隔线 ====== */
.detail-divider {
  height: 1rpx;
  background: linear-gradient(to right, transparent, var(--border-light), transparent);
  margin: var(--space-sm) 0;
}

/* ====== 实付金额 ====== */
.detail-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: var(--space-sm);
}

.detail-total__label {
  font-size: var(--text-body);
  color: var(--text-secondary);
}

.detail-total__price {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--color-primary);
}

/* ====== 时间 ====== */
.detail-time {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.detail-time__label {
  font-size: var(--text-body-sm);
  color: var(--text-tertiary);
}

.detail-time__value {
  font-size: var(--text-body-sm);
  color: var(--text-secondary);
}

/* ====== 底部按钮 ====== */
.detail-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: var(--space-md);
  padding: var(--space-md) var(--space-lg);
  padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom));
  background: var(--bg-surface);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
  z-index: 100;
}

.detail-footer__btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: var(--radius-full);
  font-size: var(--text-body);
  font-weight: 600;
  transition: all 0.15s ease;
}

.detail-footer__btn:active {
  transform: scale(0.96);
}

.detail-footer__btn--back {
  background: var(--border-light);
  color: var(--text-secondary);
}

.detail-footer__btn--poster {
  background: var(--color-primary-bg);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

.detail-footer__btn--reorder {
  background: linear-gradient(135deg, var(--color-primary) 0%, #F48C7A 100%);
  color: var(--text-white);
  box-shadow: 0 4rpx 16rpx rgba(242, 107, 94, 0.3);
}

/* ====== 海报弹窗 ====== */
.poster-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(61, 44, 37, 0.5);
  z-index: 300;
  animation: fadeIn 0.2s ease;
}

.poster-popup {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 301;
  background: var(--bg-surface);
  border-radius: var(--radius-xl);
  padding: var(--space-xl);
  width: 620rpx;
  text-align: center;
  box-shadow: 0 16rpx 48rpx rgba(61, 44, 37, 0.15);
  animation: popIn 0.35s ease both;
}

.poster-popup__handle {
  width: 48rpx;
  height: 4rpx;
  background: var(--border-medium);
  border-radius: 2rpx;
  margin: 0 auto var(--space-lg);
}

.poster-popup__title {
  font-size: var(--text-heading);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: var(--space-lg);
}

.poster-popup__image {
  width: 100%;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
}

.poster-popup__actions {
  display: flex;
  gap: var(--space-md);
  margin-top: var(--space-lg);
}

.poster-popup__btn {
  flex: 1;
  padding: 22rpx 0;
  border-radius: var(--radius-full);
  font-size: var(--text-body);
  font-weight: 600;
  text-align: center;
  transition: all 0.15s ease;
}

.poster-popup__btn:active {
  transform: scale(0.96);
}

.poster-popup__btn--save {
  background: linear-gradient(135deg, var(--color-primary) 0%, #F48C7A 100%);
  color: var(--text-white);
  box-shadow: 0 4rpx 12rpx rgba(242, 107, 94, 0.25);
}

.poster-popup__btn--share {
  background: var(--color-playful-teal);
  color: var(--text-white);
  box-shadow: 0 4rpx 12rpx rgba(91, 192, 190, 0.25);
}

.poster-popup__share-inner {
  background: none;
  border: none;
  color: inherit;
  font-size: inherit;
  font-weight: inherit;
  padding: 0;
  margin: 0;
  line-height: inherit;
}

.poster-popup__share-inner::after {
  border: none;
}

.poster-popup__close {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-tertiary);
  border-radius: 50%;
  transition: all 0.15s ease;
}

.poster-popup__close:active {
  background: var(--border-light);
}

/* ====== 隐藏 Canvas ====== */
.poster-canvas {
  position: fixed;
  left: -9999px;
  width: 600px;
  height: 800px;
}
