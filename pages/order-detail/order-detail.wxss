/* ═══════════════════════════════════════════
   pages/order-detail/order-detail.wxss — 订单详情页样式
   设计：温暖治愈 × 活力玩趣
   ═══════════════════════════════════════════ */

.detail-page {
  padding: var(--space-lg);
  padding-bottom: 160rpx;
  background: var(--bg-page);
  min-height: 100vh;
  animation: fadeIn 0.3s ease;
}

/* ====== 成功状态 ====== */
.detail-success {
  text-align: center;
  padding: 56rpx 0 32rpx;
  animation: floatUp 0.5s ease;
  position: relative;
  overflow: hidden;
}

/* 装饰小圆点 */
.detail-success__deco {
  position: absolute;
  border-radius: 50%;
  opacity: 0.15;
  pointer-events: none;
}

.detail-success__deco--1 {
  width: 80rpx;
  height: 80rpx;
  background: var(--color-playful-teal);
  top: 20rpx;
  left: 10%;
  animation: decoFloat 3s ease-in-out infinite;
}

.detail-success__deco--2 {
  width: 50rpx;
  height: 50rpx;
  background: var(--color-playful-yellow);
  top: 60rpx;
  right: 15%;
  animation: decoFloat 3s ease-in-out infinite 0.5s;
}

.detail-success__deco--3 {
  width: 60rpx;
  height: 60rpx;
  background: var(--color-playful-pink);
  top: 80rpx;
  left: 25%;
  animation: decoFloat 3s ease-in-out infinite 1s;
}

@keyframes decoFloat {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-20rpx) scale(1.1); }
}

.detail-success__icon-wrap {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto var(--space-lg);
  background: linear-gradient(135deg, var(--color-success) 0%, #8DD49A 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: popIn 0.4s ease 0.15s both;
  box-shadow: 0 8rpx 32rpx rgba(107, 196, 122, 0.3);
  position: relative;
  z-index: 1;
}

.detail-success__icon {
  color: var(--text-white);
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1;
}

.detail-success__text {
  font-size: var(--text-display);
  font-weight: 700;
  color: var(--text-primary);
  display: block;
  margin-bottom: var(--space-xs);
}

.detail-success__sub {
  font-size: var(--text-body);
  color: var(--text-tertiary);
  display: block;
}

/* 等待时长 */
.detail-success__wait {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: var(--space-md);
  padding: 10rpx 24rpx;
  background: var(--color-primary-bg);
  border-radius: var(--radius-full);
  animation: floatUp 0.4s ease 0.4s both;
}

.detail-success__wait-icon {
  font-size: 24rpx;
  line-height: 1;
}

.detail-success__wait-text {
  font-size: var(--text-body-sm);
  color: var(--text-secondary);
}

.detail-success__wait-time {
  font-weight: 700;
  color: var(--color-primary-dark);
}

/* ====== 信息卡片 ====== */
.detail-card {
  background: var(--bg-surface);
  border-radius: var(--radius-xl);
  padding: var(--space-lg);
  margin-bottom: var(--space-md);
  box-shadow: var(--shadow-md);
  animation: floatUp 0.4s ease 0.1s both;
}

.detail-card__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: var(--space-md);
  border-bottom: 1rpx solid var(--border-light);
  margin-bottom: var(--space-md);
}

.detail-card__order-no {
  font-size: var(--text-caption);
  color: var(--text-tertiary);
  font-family: monospace;
}

.detail-card__status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--text-body-sm);
  color: var(--color-primary);
  font-weight: 600;
}

.detail-card__status--done {
  color: var(--color-success);
}

.detail-card__status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-primary);
  animation: pulse 1.5s ease infinite;
}

.detail-card__status--done .detail-card__status-dot {
  background: var(--color-success);
  animation: none;
}

/* ====== 商品项 ====== */
.detail-item {
  display: flex;
  align-items: center;
  padding: var(--space-sm) 0;
}

.detail-item__image {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  background: var(--border-light);
}

.detail-item__info {
  flex: 1;
  margin-left: var(--space-md);
  min-width: 0;
}

.detail-item__name {
  font-size: var(--text-body);
  color: var(--text-primary);
  display: block;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-item__spec {
  font-size: var(--text-caption);
  color: var(--text-tertiary);
  display: block;
  margin-top: 4rpx;
}

.detail-item__right {
  text-align: right;
  flex-shrink: 0;
}

.detail-item__price {
  font-size: var(--text-body);
  color: var(--color-primary);
  font-weight: 600;
  display: block;
}

.detail-item__qty {
  font-size: var(--text-caption);
  color: var(--text-tertiary);
  display: block;
  margin-top: 4rpx;
}

/* ====== 备注 ====== */
.detail-remark {
  display: flex;
  align-items: flex-start;
  gap: var(--space-sm);
  padding: var(--space-sm) 0;
  margin-top: var(--space-sm);
  border-top: 1rpx solid var(--border-light);
}

.detail-remark__label {
  font-size: var(--text-caption);
  color: var(--text-tertiary);
  flex-shrink: 0;
}

.detail-remark__text {
  font-size: var(--text-caption);
  color: var(--text-secondary);
  flex: 1;
}

/* ====== 进度时间线 ====== */
.detail-timeline__header {
  margin-bottom: var(--space-md);
}

.detail-timeline__title {
  font-size: var(--text-subhead);
  font-weight: 600;
  color: var(--text-primary);
}

.detail-timeline__steps {
  position: relative;
  padding-left: 16rpx;
}

/* 连接线 */
.detail-timeline__steps::before {
  content: '';
  position: absolute;
  left: 34rpx;
  top: 24rpx;
  bottom: 24rpx;
  width: 3rpx;
  background: linear-gradient(to bottom, var(--color-primary), var(--border-light) 60%);
  border-radius: 2rpx;
}

.detail-timeline__step {
  display: flex;
  align-items: flex-start;
  gap: var(--space-md);
  margin-bottom: var(--space-xl);
  position: relative;
}

.detail-timeline__step:last-child {
  margin-bottom: 0;
}

.detail-timeline__step-icon-wrap {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

/* 已完成步骤 */
.detail-timeline__step--done .detail-timeline__step-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary) 0%, #F48C7A 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-white);
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(242, 107, 94, 0.25);
}

.detail-timeline__step--done .detail-timeline__step-title {
  color: var(--text-primary);
  font-weight: 600;
}

.detail-timeline__step--done .detail-timeline__step-time {
  color: var(--text-tertiary);
}

/* 进行中步骤 */
.detail-timeline__step--active .detail-timeline__step-ring {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.detail-timeline__step--active .detail-timeline__step-ring-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-primary);
  animation: pulse 1.5s ease infinite;
}

.detail-timeline__step--active .detail-timeline__step-title {
  color: var(--color-primary);
  font-weight: 600;
}

/* 未完成步骤 */
.detail-timeline__step-ring {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid var(--border-medium);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.detail-timeline__step-ring-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--border-medium);
}

.detail-timeline__step-title {
  font-size: var(--text-body);
  color: var(--text-tertiary);
  display: block;
}

.detail-timeline__step-time {
  font-size: var(--text-caption);
  color: var(--text-tertiary);
  margin-top: 4rpx;
  display: block;
}

.detail-timeline__step-info {
  flex: 1;
  padding-top: 4rpx;
}

/* ====== 时间 ====== */
.detail-time {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.detail-time__label {
  font-size: var(--text-body-sm);
  color: var(--text-tertiary);
}

.detail-time__value {
  font-size: var(--text-body-sm);
  color: var(--text-secondary);
}

/* ====== 底部按钮 ====== */
.detail-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: var(--space-md);
  padding: var(--space-md) var(--space-lg);
  padding-bottom: calc(var(--space-md) + env(safe-area-inset-bottom));
  background: var(--bg-surface);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.04);
  z-index: 100;
}

.detail-footer__btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: var(--radius-full);
  font-size: var(--text-body);
  font-weight: 600;
  transition: all 0.15s ease;
}

.detail-footer__btn:active {
  transform: scale(0.96);
}

.detail-footer__btn--back {
  background: var(--border-light);
  color: var(--text-secondary);
}

.detail-footer__btn--poster {
  background: var(--color-primary-bg);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
}

.detail-footer__btn--reorder {
  background: linear-gradient(135deg, var(--color-primary) 0%, #F48C7A 100%);
  color: var(--text-white);
  box-shadow: 0 4rpx 16rpx rgba(242, 107, 94, 0.3);
}

/* ====== 海报弹窗 ====== */
.poster-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(61, 44, 37, 0.5);
  z-index: 300;
  animation: fadeIn 0.2s ease;
}

.poster-popup {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 301;
  background: var(--bg-surface);
  border-radius: var(--radius-xl);
  padding: var(--space-xl);
  width: 620rpx;
  text-align: center;
  box-shadow: 0 16rpx 48rpx rgba(61, 44, 37, 0.15);
  animation: popIn 0.35s ease both;
}

.poster-popup__handle {
  width: 48rpx;
  height: 4rpx;
  background: var(--border-medium);
  border-radius: 2rpx;
  margin: 0 auto var(--space-lg);
}

.poster-popup__title {
  font-size: var(--text-heading);
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: var(--space-lg);
}

.poster-popup__image {
  width: 100%;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
}

.poster-popup__actions {
  display: flex;
  gap: var(--space-md);
  margin-top: var(--space-lg);
}

.poster-popup__btn {
  flex: 1;
  padding: 22rpx 0;
  border-radius: var(--radius-full);
  font-size: var(--text-body);
  font-weight: 600;
  text-align: center;
  transition: all 0.15s ease;
}

.poster-popup__btn:active {
  transform: scale(0.96);
}

.poster-popup__btn--save {
  background: linear-gradient(135deg, var(--color-primary) 0%, #F48C7A 100%);
  color: var(--text-white);
  box-shadow: 0 4rpx 12rpx rgba(242, 107, 94, 0.25);
}

.poster-popup__btn--share {
  background: var(--color-playful-teal);
  color: var(--text-white);
  box-shadow: 0 4rpx 12rpx rgba(91, 192, 190, 0.25);
}

.poster-popup__share-inner {
  background: none;
  border: none;
  color: inherit;
  font-size: inherit;
  font-weight: inherit;
  padding: 0;
  margin: 0;
  line-height: inherit;
}

.poster-popup__share-inner::after {
  border: none;
}

.poster-popup__close {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-tertiary);
  border-radius: 50%;
  transition: all 0.15s ease;
}

.poster-popup__close:active {
  background: var(--border-light);
}

/* ====== 隐藏 Canvas ====== */
.poster-canvas {
  position: fixed;
  left: -9999px;
  width: 600px;
  height: 800px;
}
